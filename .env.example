# Copy to .env, or put these in your shell profile. The real .env is gitignored.
#
# The OAuth client json you downloaded from the Google Cloud console.
# Keep it OUTSIDE any project folder. See docs/01-google-cloud-setup.md section 1.5.
GTM_OAUTH_CLIENT=~/.config/gcloud/consent-pro-gtm-client.json

# Where the refresh token is written by scripts/authorise.py.
# Use a DIFFERENT path for a read-only token and a write token, so revoking
# one does not break the other.
GTM_OAUTH_TOKEN=~/.config/gcloud/consent-pro-gtm-token.txt
