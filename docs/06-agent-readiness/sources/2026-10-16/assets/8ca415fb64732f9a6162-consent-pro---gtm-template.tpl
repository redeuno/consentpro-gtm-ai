const dataLayerPush = require('createQueue')('dataLayer');
const gtagSet = require('gtagSet');
const log = require('logToConsole');
const setDefaultConsentState = require('setDefaultConsentState');
const copyFromWindow = require('copyFromWindow');
const getCookieValues = require('getCookieValues');
const updateConsentState = require('updateConsentState');
const decodeUriComponent = require('decodeUriComponent');
const JSON = require('JSON');
const Object = require('Object');

// Configuration
const regionDefaults = data.regionDefaults || [];
const waitForUpdate = data.waitForUpdate ? (data.waitForUpdate - 0) : 2000;

log('[GTM] Configuration loaded:');
log('[GTM] - regionDefaults:', regionDefaults);
log('[GTM] - waitForUpdate (original):', data.waitForUpdate);
log('[GTM] - waitForUpdate (converted):', waitForUpdate);
log('[GTM] - waitForUpdate type:', typeof waitForUpdate);
log('[GTM] - data object:', data);

// Consent Mapping - Maps GTM consent types to Consent Pro v2 categories
const consentMapping = {
  'ad_personalization': 'marketing',
  'ad_storage': 'marketing', 
  'ad_user_data': 'marketing',
  'analytics_storage': 'analytics',
  'functionality_storage': 'personalization',
  'personalization_storage': 'personalization',
  'security_storage': 'essential',
};


/**
 * Converts region setting to GTM consent states
 */
function getRegionConsentDefaults(setting) {
  log('[GTM] getRegionConsentDefaults called with setting:', setting);
  const result = {
    ad_storage: setting.adStorage || 'denied',
    analytics_storage: setting.analyticsStorage || 'denied',
    ad_user_data: setting.adUserData || 'denied',
    ad_personalization: setting.adPersonalization || 'denied',
    functionality_storage: setting.functionalityStorage || 'denied',
    personalization_storage: setting.personalizationStorage || 'denied',
    security_storage: 'granted' // Always granted - counts as an Essential category
  };
  log('[GTM] getRegionConsentDefaults returning:', result);
  return result;
}

/**
 * Sets region-specific consent defaults
 */
function setRegionDefaults() {
  log('[GTM] setRegionDefaults() called');
  
  let globalSetting = null;
  const regionSettings = [];
  
  // Process each region setting
  for (let i = 0; i < regionDefaults.length; i++) {
    const setting = regionDefaults[i];
    const consentDefaults = getRegionConsentDefaults(setting);
    if (waitForUpdate > 0) {
      consentDefaults.wait_for_update = waitForUpdate;
    }
    
    const regionList = (setting.regions || 'Global')
      .toLowerCase()
      .split(',')
      .map(r => r.trim())
      .filter(r => r);
    
    if (regionList.length > 0 && regionList[0] === 'global') {
      globalSetting = consentDefaults;
      log('[GTM] Global setting found');
    } else if (regionList.length > 0) {
      consentDefaults.region = regionList;
      regionSettings.push({ defaults: consentDefaults, regions: regionList });
    }
  }
  
  // Step 1: Apply Global setting FIRST (without region parameter)
  if (globalSetting) {
    setDefaultConsentState(globalSetting);
    log('[GTM] Global default applied (affects all regions)');
  }
  
  // Step 2: Apply region-specific overrides AFTER global
  for (let i = 0; i < regionSettings.length; i++) {
    setDefaultConsentState(regionSettings[i].defaults);
    log('[GTM] Region override applied for:', regionSettings[i].regions);
  }
  
  // Step 3: Privacy-first fallback - only if no Global settings configured
  if (!globalSetting) {
    log('[GTM] Setting privacy-first defaults');
    const privacyDefaults = {
      ad_storage: 'denied',
      analytics_storage: 'denied', 
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      functionality_storage: 'denied',
      personalization_storage: 'denied',
      security_storage: 'granted'
    };
    if (waitForUpdate > 0) {
      privacyDefaults.wait_for_update = waitForUpdate;
    }
    setDefaultConsentState(privacyDefaults);
    log('[GTM] Privacy-first defaults set');
  }
  
  log('[GTM] setRegionDefaults() completed');
}

/**
 * Updates consent based on Consent Pro v2 cookie
 */
function updateFromConsentCookie() {
  const consentCookie = getCookieValues('fs-consent');
  
  if (consentCookie.length === 0) {
    log('[GTM] No consent cookie found - using defaults only');
    return;
  }
  
  const rawValue = consentCookie[0];
  if (!rawValue || typeof rawValue !== 'string') {
    log('[GTM] Invalid consent cookie value');
    return;
  }
  
  const decodedValue = decodeUriComponent(rawValue);
  if (!decodedValue) {
    log('[GTM] Failed to decode consent cookie');
    return;
  }
  
  const consentData = JSON.parse(decodedValue);
  if (!consentData || typeof consentData !== 'object') {
    log('[GTM] Failed to parse consent cookie data');
    return;
  }
  
  log('[GTM] Parsed consent cookie data:', consentData);
  
  // Extract choices
  const choices = consentData.choices;
  if (!choices || typeof choices !== 'object') {
    log('[GTM] No choices found in consent data');
    return;
  }
  
  log('[GTM] Extracted consent choices:', choices);
  
  // Map choices to GTM consent types
  const consentUpdate = {};
  for (const gtmType in consentMapping) {
    const choiceCategory = consentMapping[gtmType];
    
    if (gtmType === 'security_storage') {
      consentUpdate[gtmType] = 'granted'; // Always granted
    } else if (choices.hasOwnProperty(choiceCategory)) {
      consentUpdate[gtmType] = choices[choiceCategory] ? 'granted' : 'denied';
    }
  }
  
  // Update consent state with actual user choices
  updateConsentState(consentUpdate);
  log('[GTM] Updated consent state:', consentUpdate);
  
  // Fire dataLayer event
  consentUpdate.event = 'gtm_consent_update';
  dataLayerPush(consentUpdate);
}

// Main execution
log('[GTM] Finsweet Consent Pro v2 GTM Template initializing...');

log('[GTM] About to set gtagSet...');
// Set advanced settings first
gtagSet({
  url_passthrough: !!data.urlPassthrough,
  ads_data_redaction: !!data.adsDataRedaction
});
log('[GTM] gtagSet completed successfully');

// 1. Set region-specific consent defaults immediately
log('[GTM] ==================== STARTING REGION DEFAULTS ====================');
log('[GTM] regionDefaults length:', regionDefaults.length);
log('[GTM] regionDefaults data:', regionDefaults);

if (typeof setRegionDefaults === 'function') {
  log('[GTM] setRegionDefaults function exists, calling it...');
  setRegionDefaults();
  log('[GTM] setRegionDefaults call completed');
} else {
  log('[GTM] ERROR: setRegionDefaults is not a function!');
}

log('[GTM] ==================== FINISHED REGION DEFAULTS ====================');

// 2. Update with actual consent choices if cookie exists
log('[GTM] ==================== STARTING COOKIE UPDATE ====================');
updateFromConsentCookie();
log('[GTM] ==================== FINISHED COOKIE UPDATE ====================');

// 3. Ensure essential-activated event is fired for GTM triggers
const dataLayerFromWindow = copyFromWindow('dataLayer');
const hasActivatedEssential = dataLayerFromWindow.some(item => 
  item && typeof item === 'object' && item.event === 'essential-activated'
);

if (!hasActivatedEssential) {
  dataLayerPush({ event: 'essential-activated' });
  log('[GTM] Fired essential-activated event');
}

log('[GTM] Template initialization complete');


// Call data.gtmOnSuccess when the tag is finished.
data.gtmOnSuccess();


